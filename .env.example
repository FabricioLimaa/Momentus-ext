# Exemplo de Variáveis de Ambiente do Momentus
# Copie este arquivo para .env e preencha com as chaves oficiais do seu projeto Firebase

EXPO_PUBLIC_FIREBASE_API_KEY=sua_chave_de_api_web_aqui
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Domínio Oficial de Produção
EXPO_PUBLIC_APP_DOMAIN=www.momentus.app.br
EXPO_PUBLIC_APP_URL=https://www.momentus.app.br


{
  "expo": {
    "name": "Momentus",
    "slug": "momentus",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momentus",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.fabriciolima.momentus",
      "associatedDomains": [
        "applinks:www.momentus.app.br",
        "applinks:momentus.app.br",
        "applinks:app.momentus.app.br"
      ],
      "infoPlist": {
        "NSCalendarsUsageDescription": "O Momentus precisa de acesso ao seu calendário para sincronizar suas rotinas e hábitos.",
        "NSRemindersUsageDescription": "O Momentus precisa de permissão para lembretes de rotinas.",
        "NSSpeechRecognitionUsageDescription": "O Momentus utiliza o reconhecimento de voz para preencher automaticamente data, horário e categoria das suas rotinas.",
        "NSMicrophoneUsageDescription": "O Momentus utiliza o microfone para criar rotinas em 1 toque por comando de voz."
      }
    },
    "android": {
      "package": "br.com.fabriciolima.momentus",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.momentus.app.br",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "momentus.app.br",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "app.momentus.app.br",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 80
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "O Momentus sincroniza suas tarefas diretamente na agenda do dispositivo."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-audio",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "O Momentus utiliza o Face ID para proteger sua sessão e chaves criptográficas locais."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Momentus utiliza o Face ID ou biometria para proteger o acesso às suas rotinas."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "br.com.fabriciolima.momentus.widgets",
          "groupIdentifier": "group.br.com.fabriciolima.momentus",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "MomentusWidget",
              "displayName": "Momentus",
              "description": "Acompanhe suas próximas rotinas, seu streak diário e dê check rápido direto da tela inicial.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": false
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MomentusWidget",
              "label": "Momentus • Rotinas & Streak",
              "description": "Acompanhe suas próximas rotinas, seu streak diário e dê check rápido direto da tela inicial.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Momentus utiliza o microfone para criar rotinas em 1 toque por comando de voz.",
          "speechRecognitionPermission": "O Momentus utiliza o reconhecimento de voz para preencher automaticamente data, horário e categoria das suas rotinas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appName": "Momentus",
      "developer": "Fabricio Lima",
      "contactEmail": "contato@momentus.app.br",
      "officialWebsite": "https://www.momentus.app.br/",
      "webAccess": "https://app.momentus.app.br/",
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "br.com.fabriciolima.momentus.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.br.com.fabriciolima.momentus"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ccb122a5-0652-4406-befa-e2327dc6c1f5"
      }
    },
    "owner": "momentus-company"
  }
}
